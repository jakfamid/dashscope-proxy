# Salin file ini jadi ".env" lalu isi nilai sungguhan sebelum menjalankan
# "docker compose up -d" -- JANGAN commit file ".env" (sudah di .gitignore).

# Daftar API key DashScope sendiri dibaca dari file "api-key.txt" di folder ini
# (satu key per baris, lines diawali "#" diabaikan) -- BUKAN dari .env.
# File itu sudah masuk .gitignore, jangan pernah commit.

# Token gerbang -- klien (mis. kredensial n8n) pakai token ini di field "API Key",
# BUKAN key DashScope asli. Generate lewat: openssl rand -hex 32
DASHSCOPE_PROXY_TOKEN=ganti_dengan_string_acak_panjang
